<main class="dashboard" id="workspace" data-id="<%= @id %>" data-status="<%= field('status') %>" data-started="<%= field('prepare_started_at') %>" data-completed="<%= field('completed_at') %>" data-busy="<%= @presentation['busy'] %>">
  <header class="dashboard__header">
    <div><p class="eyebrow">Managed workspace</p><h1><%= @id %></h1><p><%= field('branch') %></p></div>
    <a class="button button--subtle" href="/workspaces">All workspaces</a>
  </header>
  <section class="status-panel" aria-labelledby="status">
    <div class="status-row">
      <h2 id="status" role="status"><%= escape(@presentation['title']) %></h2>
      <span id="activity" <%= 'hidden' unless @presentation['busy'] %>><span class="activity-dot" aria-hidden="true"></span> In progress · <span id="elapsed">—</span></span>
    </div>
    <p id="message"><%= field('message') %></p>
    <ol class="stepper" id="progress" aria-label="Setup progress">
      <% @presentation['steps'].each do |step| %>
        <li class="step" data-step-state="<%= step['state'] %>" <%= 'aria-current="step"' if step['state'] == 'active' %>><span class="step-bullet" aria-hidden="true"></span><span><%= escape(step['label']) %></span><span class="step-outcome"><%= escape(step_outcome(step)) %></span></li>
      <% end %>
    </ol>
    <section class="error-panel setup-error" id="error-panel" role="alert" <%= 'hidden' unless @presentation['error'] %>>
      <h3>What went wrong</h3><pre id="error"><%= escape(@presentation['error']) %></pre>
    </section>
    <p id="connection" role="status"></p>
  </section>
  <section class="status-panel controls-panel" aria-labelledby="actions-settings-title">
    <h2 id="actions-settings-title">Actions &amp; settings</h2>
    <div class="workspace-actions-group" aria-labelledby="actions-heading">
      <h3 id="actions-heading">Workspace actions</h3>
      <div class="workspace-actions">
        <a id="preview" class="button button--primary" href="<%= escape(Config.preview_url(@id)) %>" <%= 'hidden' unless @presentation['ready'] %> target="_blank" rel="noopener noreferrer">Open workspace</a>
        <div id="actions" class="workspace-actions"><% @presentation['actions'].each do |action| %><%= action_form(action) %><% end %></div>
        <a class="button button--subtle" href="/workspaces/<%= @id %><%= @snapshot['log_source'] == 'backend' ? '?log=backend' : '' %>">Refresh status</a>
      </div>
      <p id="source-update-message" role="status"><%= field('source_update_message') %></p>
    </div>
    <div class="workspace-settings" aria-labelledby="environment-overrides">
      <h3 id="environment-overrides">Editable environment</h3>
      <p class="muted">One NAME=value per line. These non-secret settings start from <code>default_editable_env</code> in the trusted recipe. Edit values to customize this workspace; remove a line to restore its default.</p>
      <p class="muted">Do not enter secrets: editor values appear in the dashboard and status API. Add other non-secret names as needed. Previously saved values outside the editor remain hidden and unchanged.</p>
      <form method="post" action="/workspaces/<%= @id %>/environment" id="environment-form" data-environment-form data-environment-presets="<%= escape(environment_presets_json) %>">
        <fieldset class="env-fieldset" data-environment-fieldset <%= 'disabled' if @presentation['busy'] %>>
          <legend class="env-legend">Workspace settings</legend>
          <% unless environment_presets.empty? %>
            <div data-preset-controls hidden>
              <label class="env-input-label" for="environment-preset">Preset</label>
              <select id="environment-preset" class="env-preset-select" data-environment-preset aria-describedby="environment-preset-help editable-env-help">
                <option value="">Select a preset…</option>
                <% environment_presets.each_key do |name| %>
                  <option value="<%= escape(name) %>"><%= escape(name) %></option>
                <% end %>
              </select>
              <p class="muted" id="environment-preset-help">Choosing a preset replaces your current draft in the editor. Changes are local until you use Save &amp; restart.</p>
            </div>
          <% end %>
          <label class="env-input-label" for="editable-env">Environment variables</label>
          <textarea id="editable-env" name="editable_env" rows="8" spellcheck="false" autocomplete="off" autocapitalize="off" aria-describedby="editable-env-help"><%= escape(editable_environment_text) %></textarea>
          <p class="muted" id="editable-env-help">Values may contain =. Blank lines are ignored. Names are case-sensitive and cannot repeat.</p>
        </fieldset>
        <div class="env-actions">
          <button class="button button--primary" data-env-submit <%= 'disabled' if @presentation['busy'] %>>Save &amp; restart</button>
        </div>
        <p class="muted" id="environment-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
  <section class="log-panel" aria-labelledby="log-title">
    <div class="log-header"><h2 id="log-title">Live <%= field('log_source') == 'backend' ? 'backend' : 'setup' %> log</h2><time id="updated"><%= field('updated_at') %></time></div>
    <nav class="log-switch" aria-label="Log source">
      <a href="?log=setup" data-log-source="setup" <%= 'aria-current="page"' if @snapshot['log_source'] != 'backend' %>>Setup log</a>
      <a href="?log=backend" data-log-source="backend" <%= 'aria-current="page"' if @snapshot['log_source'] == 'backend' %>>Backend log</a>
    </nav>
    <pre id="log" tabindex="0" aria-label="<%= field('log_source') == 'backend' ? 'Backend' : 'Setup' %> log"><%= field('log_tail') %></pre>
  </section>
  <details class="status-panel"><summary>Workspace details</summary><dl><dt>Preview URL</dt><dd><a class="detail-link" href="<%= escape(Config.preview_url(@id)) %>" target="_blank" rel="noopener noreferrer"><%= escape(Config.preview_url(@id)) %></a> <span class="muted">Available when ready</span></dd><dt>Branch</dt><dd><%= field('branch') %></dd><dt>Path</dt><dd><code><%= field('path') %></code></dd><dt>Related PR</dt><dd><%= escape(@snapshot.dig('related_pr', 'number') || 'None') %></dd><dt>Created</dt><dd><%= escape(@snapshot['created_at'] || 'Unavailable') %></dd><dt>Last startup</dt><dd><%= escape(@snapshot['started_at'] || 'Never') %></dd></dl></details>
  <section class="status-panel danger-zone" aria-labelledby="danger-heading">
    <h2 id="danger-heading">Danger Zone</h2>
    <p>Deleting this workspace stops its server and removes its worktree. <strong>Discard uncommitted and untracked changes</strong> permanently. The branch and committed work are preserved.</p>
    <form method="post" action="/workspaces/<%= @id %>/remove" id="remove-form">
      <label for="confirm-id">Type <code><%= @id %></code> to confirm deletion</label>
      <input id="confirm-id" name="confirm_id" required autocomplete="off" spellcheck="false" aria-describedby="remove-warning" <%= 'disabled' if @presentation['busy'] %>>
      <p class="muted" id="remove-warning">This cannot restore uncommitted or untracked files.</p>
      <button class="button button--danger" <%= 'disabled' if @presentation['busy'] %>>Delete workspace</button>
    </form>
  </section>
  <noscript><a href="/workspaces/<%= @id %>">Refresh status</a></noscript>
</main>
