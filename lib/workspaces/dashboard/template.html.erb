<main class="dashboard" id="workspace" data-id="<%= @id %>" data-status="<%= field('status') %>" data-started="<%= field('prepare_started_at') %>" data-completed="<%= field('completed_at') %>" data-busy="<%= @presentation['busy'] %>" data-disclosure-state="<%= escape(@presentation['state']) %>">
  <header class="dashboard__header">
    <div class="dashboard__title"><p class="eyebrow">Managed workspace</p><h1 class="mono-title"><%= @id %></h1></div>
    <div class="header-actions"><a class="button button--subtle" href="/workspaces/<%= @id %>">Back to workspace</a><a class="button button--subtle" href="/workspaces">All workspaces</a></div>
  </header>
  <section class="status-panel lead" id="lead" data-section="lead" aria-labelledby="status" <%= 'hidden' unless section?('lead') %>>
    <div class="lead__text">
      <h2 id="status" role="status"><%= escape(@presentation['headline']) %></h2>
      <p id="summary" class="lead__summary"><%= escape(@presentation['summary']) %></p>
    </div>
    <div class="build-progress" id="build-progress" <%= 'hidden' unless @presentation['progress'] %>>
      <div class="progress-bar" id="progress-bar" role="progressbar" aria-label="Setup progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= progress_percent %>" aria-valuetext="<%= escape(progress_valuetext) %>" data-slow="<%= @presentation.dig('progress', 'slow') ? 'true' : 'false' %>"><span class="progress-bar__fill" id="progress-fill" style="inline-size: <%= progress_percent %>%"></span></div>
      <div class="progress-meta">
        <p class="progress-meta__step"><span class="activity-dot" aria-hidden="true"></span><span id="progress-step"><%= escape(progress_step_text) %></span></p>
        <p class="progress-meta__time muted"><span id="progress-percent"><%= progress_percent %>%</span><span aria-hidden="true"> · </span><span id="elapsed"><%= escape(progress_elapsed_text) %></span><span id="progress-eta"><%= escape(progress_eta_suffix) %></span></p>
      </div>
    </div>
    <div class="lead__actions">
      <a id="preview" class="button button--primary button--large" href="<%= escape(Config.preview_url(@id)) %>" <%= 'hidden' unless @presentation['ready'] %> target="_blank" rel="noopener noreferrer">Open workspace</a>
      <div id="lead-action" class="lead__action"><%= lead_action_form(@presentation['lead_action']) %></div>
    </div>
    <p id="sleep-note" class="muted" <%= 'hidden' if sleep_note.empty? %>><%= escape(sleep_note) %></p>
    <p id="message" class="muted" hidden><%= field('message') %></p>
    <section class="error-panel setup-error" id="error-panel" role="alert" <%= 'hidden' unless @presentation['error'] %>>
      <h3>What went wrong</h3><pre id="error"><%= escape(@presentation['error']) %></pre>
    </section>
    <p id="connection" role="status"></p>
  </section>
  <details class="status-panel disclosure" id="environment-disclosure" data-section="environment" <%= 'open' if @presentation.dig('open', 'environment') %> <%= 'hidden' unless section?('environment') %>>
    <summary><span id="environment-title"><%= escape(@presentation['environment_title']) %></span><span class="badge" id="environment-preset-badge" <%= 'hidden' unless @presentation['current_preset'] %>><%= escape(preset_badge_text) %></span><span class="disclosure__hint">Presets and environment variables</span></summary>
    <div class="workspace-settings" aria-labelledby="environment-title">
      <form method="post" action="/workspaces/<%= @id %>/environment" id="environment-form" class="stack" data-environment-form data-environment-presets="<%= escape(environment_presets_json) %>">
        <fieldset class="env-fieldset" data-environment-fieldset <%= 'disabled' if @presentation['busy'] %>>
          <legend class="env-legend">Workspace settings</legend>
          <% unless environment_presets.empty? %>
            <div class="stack stack--tight" data-preset-controls hidden>
              <p class="env-input-label" id="environment-preset-label">Preset</p>
              <div class="env-preset-buttons" role="group" aria-labelledby="environment-preset-label" aria-describedby="environment-preset-help">
                <% environment_presets.each_key do |name| %>
                  <button type="button" class="button button--subtle env-preset-button" data-environment-preset="<%= escape(name) %>" aria-pressed="false"><%= escape(name) %></button>
                <% end %>
              </div>
              <p class="muted" id="environment-preset-help">Presets decide which app this workspace runs. Select one, then use <strong data-submit-label><%= escape(@presentation['environment_submit']) %></strong> to apply it.</p>
            </div>
          <% end %>
          <div class="stack stack--tight">
            <p class="env-input-label" id="env-rows-label">Environment variables</p>
            <div class="env-rows" id="env-rows" role="group" aria-labelledby="env-rows-label" data-env-rows>
              <% environment_rows.each_with_index do |row, index| %>
                <%= env_row_html(index, row) %>
              <% end %>
            </div>
            <div class="env-row-actions">
              <button type="button" class="button button--subtle button--small" data-env-add-row hidden>Add variable</button>
            </div>
            <% unless vault_status['available'] %>
              <p class="muted env-vault-note" id="env-vault-note"><%= escape(vault_status['problem'] || 'Secrets are not available.') %></p>
            <% end %>
            <p class="muted env-secret-help">Secrets are write-only: once saved their values are never shown again. Leave a secret's value blank to keep what is stored.</p>
          </div>
          <template id="env-row-template"><%= env_row_html('__INDEX__', { 'name' => '', 'value' => '', 'secret' => false }) %></template>
        </fieldset>
        <div class="env-actions">
          <button class="button button--primary" data-env-submit <%= 'disabled' if @presentation['busy'] %>><%= escape(@presentation['environment_submit']) %></button>
        </div>
        <p class="muted" id="environment-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </details>
  <details class="status-panel disclosure" id="technical-disclosure" data-section="technical" <%= 'open' if @presentation.dig('open', 'technical') %> <%= 'hidden' unless section?('technical') %>>
    <summary><span>Technical details</span><span class="disclosure__hint">Setup steps, logs and workspace controls</span></summary>
    <div class="technical stack stack--loose">
      <div class="workspace-actions-group stack stack--snug" data-section="actions" aria-labelledby="actions-heading" <%= 'hidden' unless section?('actions') %>>
        <h3 id="actions-heading">Workspace controls</h3>
        <div class="workspace-actions">
          <div id="actions" class="workspace-actions"><% @presentation['actions'].each do |action| %><%= action_form(action) %><% end %></div>
        </div>
        <p id="source-update-message" role="status"><%= field('source_update_message') %></p>
      </div>
      <section class="log-panel" data-section="log" aria-labelledby="log-title" <%= 'hidden' unless section?('log') %>>
        <div class="log-header"><h3 id="log-title">Live <%= field('log_source') == 'backend' ? 'backend' : 'setup' %> log</h3><time id="updated"><%= field('updated_at') %></time></div>
        <nav class="log-switch" aria-label="Log source">
          <a href="?log=setup" data-log-source="setup" <%= 'aria-current="page"' if @snapshot['log_source'] != 'backend' %>>Setup steps</a>
          <a href="?log=backend" id="backend-tab" data-log-source="backend" <%= 'aria-current="page"' if @snapshot['log_source'] == 'backend' %> <%= 'hidden' unless backend_tab? %>>Web server log</a>
        </nav>
        <div id="steps" class="step-logs" data-step-logs <%= 'hidden' if @snapshot['log_source'] == 'backend' %>>
          <% @presentation['steps'].each do |step| %><%= step_accordion(step) %><% end %>
          <details class="step-log step-log--full" id="full-log" data-step-log="full">
            <summary><span class="step-log__status" aria-hidden="true"></span><span class="step-log__name">Full setup log</span><span class="step-log__outcome" id="full-log-outcome"><%= escape(full_log_outcome) %></span></summary>
            <pre tabindex="0" aria-label="Full setup log"><%= field('log_tail') if @snapshot['log_source'] != 'backend' %></pre>
          </details>
        </div>
        <pre id="log" tabindex="0" aria-label="Web server log" <%= 'hidden' unless @snapshot['log_source'] == 'backend' %>><%= field('log_tail') if @snapshot['log_source'] == 'backend' %></pre>
      </section>
      <section class="stack stack--snug" data-section="details" <%= 'hidden' unless section?('details') %>>
        <h3>Workspace details</h3>
        <dl><dt>Preview URL</dt><dd><a class="detail-link" href="<%= escape(Config.preview_url(@id)) %>" target="_blank" rel="noopener noreferrer"><%= escape(Config.preview_url(@id)) %></a> <span class="muted">Available when ready</span></dd><dt>Branch</dt><dd><%= field('branch') %></dd><dt>Path</dt><dd><code><%= field('path') %></code></dd><dt>Related PR</dt><dd><%= escape(@snapshot.dig('related_pr', 'number') || 'None') %></dd><dt>Created</dt><dd><%= escape(@snapshot['created_at'] || 'Unavailable') %></dd><dt>Last startup</dt><dd><%= escape(@snapshot['started_at'] || 'Never') %></dd></dl>
      </section>
      <section class="danger-zone" data-section="danger" aria-labelledby="danger-heading" <%= 'hidden' unless section?('danger') %>>
        <h3 id="danger-heading">Danger Zone</h3>
        <p>Deleting this workspace stops its server and removes its worktree. <strong>Discard uncommitted and untracked changes</strong> permanently. The branch and committed work are preserved.</p>
        <form method="post" action="/workspaces/<%= @id %>/remove" id="remove-form">
          <label for="confirm-id">Type <code><%= @id %></code> to confirm deletion</label>
          <input id="confirm-id" name="confirm_id" required autocomplete="off" spellcheck="false" aria-describedby="remove-warning" <%= 'disabled' if @presentation['busy'] %>>
          <p class="muted" id="remove-warning">This cannot restore uncommitted or untracked files.</p>
          <button class="button button--danger" <%= 'disabled' if @presentation['busy'] %>>Delete workspace</button>
        </form>
      </section>
    </div>
  </details>
  <noscript><a href="/workspaces/<%= @id %>/settings">Refresh status</a></noscript>
</main>
